<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The server is reached as plain ws:// on the home LAN (token-gated relay on the Mac).
	     NSAllowsLocalNetworking permits cleartext to local addresses only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>連線到同一個 Wi-Fi 上的語音伺服器。</string>
</dict>
</plist>
